{
  "name": "@suzumiyaaoba/tpeg",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tsconfig/strictest": "^2.0.5",
    "@types/bun": "latest",
    "fast-check": "^4.9.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "husky": "^9.1.7"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "prepare": "bunx husky",
    "lint": "bunx biome lint ./packages",
    "check": "bunx biome check ./packages",
    "fix": "bunx biome check --fix --unsafe ./packages",
    "format": "bunx biome format --write ./packages",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "test:perf": "TPEG_STRICT_PERF=1 bun test",
    "typecheck": "bun run typecheck:all",
    "typecheck:all": "bun run typecheck:core && bun run typecheck:ast && bun run typecheck:combinator && bun run typecheck:parser && bun run typecheck:generator && bun run typecheck:type-inference && bun run typecheck:parser-sample && bun run typecheck:samples && bun run typecheck:cli",
    "typecheck:core": "cd packages/core && bun run typecheck",
    "typecheck:ast": "cd packages/ast && bun run typecheck",
    "typecheck:combinator": "cd packages/combinator && bun run typecheck",
    "typecheck:parser": "cd packages/parser && bun run typecheck",
    "typecheck:generator": "cd packages/generator && bun run typecheck",
    "typecheck:type-inference": "cd packages/type-inference && bun run typecheck",
    "typecheck:parser-sample": "cd packages/parser-sample && bun run typecheck",
    "typecheck:samples": "cd packages/samples && bun run typecheck",
    "typecheck:cli": "cd packages/cli && bun run typecheck",
    "build": "bun run build:all",
    "build:all": "bun run build:core && bun run build:ast && bun run build:combinator && bun run build:parser && bun run build:generator && bun run build:type-inference && bun run build:parser-sample && bun run build:samples && bun run build:cli",
    "build:core": "cd packages/core && bun run build",
    "build:ast": "cd packages/ast && bun run build",
    "build:combinator": "cd packages/combinator && bun run build",
    "build:parser": "cd packages/parser && bun run build",
    "build:generator": "cd packages/generator && bun run build",
    "build:type-inference": "cd packages/type-inference && bun run build",
    "build:parser-sample": "cd packages/parser-sample && bun run build",
    "build:samples": "cd packages/samples && bun run build",
    "build:cli": "cd packages/cli && bun run build",
    "demo": "cd packages/parser-sample && bun run demo",
    "demo:basic": "cd packages/parser-sample && bun run demo:basic",
    "demo:grammar": "cd packages/parser-sample && bun run demo:grammar",
    "demo:files": "cd packages/parser-sample && bun run demo:files",
    "bench": "bun run bench:parser",
    "bench:parser": "cd packages/parser && bun run bench"
  }
}
