{
  "name": "@suzumiyaaoba/tpeg-generator",
  "version": "0.1.0",
  "description": "Code generation system for TPEG parsers with template-based output",
  "keywords": [
    "code-generation",
    "eta",
    "generator",
    "parser",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "author": "SuzumiyaAoba",
  "files": [
    "dist",
    "templates",
    "README.md",
    "README.ja.md",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && vp test packages/generator"
  },
  "dependencies": {
    "@suzumiyaaoba/tpeg-combinator": "workspace:*",
    "@suzumiyaaoba/tpeg-core": "workspace:*",
    "@suzumiyaaoba/tpeg-parser": "workspace:*",
    "eta": "^3.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
