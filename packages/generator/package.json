{
  "name": "@suzumiyaaoba/tpeg-generator",
  "version": "0.1.0",
  "description": "Code generation system for TPEG parsers with template-based output",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "templates", "README.md", "README.ja.md", "package.json"],
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "parser",
    "generator",
    "code-generation",
    "template",
    "eta",
    "typescript"
  ],
  "author": "SuzumiyaAoba",
  "license": "MIT",
  "dependencies": {
    "eta": "^3.4.0",
    "@suzumiyaaoba/tpeg-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
