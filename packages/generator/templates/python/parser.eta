def <%~ it.parseName %>(text, rule=None, offset=0, *, transforms=None, max_depth=256, complete=False):
    """Parse a rule. Positions are UTF-16 offsets, like TPEG's TypeScript API.

    Transforms accept a captured value and return a dict with success and
    value/error fields. Each invocation has its own memo tables and limits.
    Set complete=True to require the chosen rule to consume the entire input.
    """
    if not isinstance(text, str):
        raise TypeError("text must be a string")
    session = _Session(text, {**_TRANSFORMS, **(transforms or {})}, max_depth)
    if type(max_depth) is not int or max_depth <= 0:
        result = session.fail(0, "valid maximum parse depth", True, True)
    elif type(offset) is not int or offset < 0 or offset > session.length:
        result = session.fail(0, "valid input offset", True, True)
    else:
        result = session.rule(rule or _GRAMMAR["start"], offset, 0)
    if result[0] and complete and result[3] != session.length:
        result = session.fail(result[3], "end of input")
    if result[0]:
        return {"success": True, "val": result[1], "current": result[2], "next": result[3]}
    return {"success": False, "error": result[1]}
