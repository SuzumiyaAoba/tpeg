                    return result
                result = self.ok(None, pos, pos)
            if kind == "Skip":
                return self.ok(_IGNORED, pos, result[3])
            return result
        if kind in ("PositiveLookahead", "NegativeLookahead"):
            if not result[0] and result[1].get("abort"):
                return result
            if result[0] == (kind == "PositiveLookahead"):
                return self.ok(None, pos, pos)
            return (False, {key: value for key, value in result[1].items() if key != "fatal"}) if kind == "PositiveLookahead" else self.fail(pos, "negative lookahead")
        if not result[0]:
            return result
        if kind == "Span":
            return self.ok(_text(self.data[pos * 2:result[3] * 2]), pos, result[3])
        if kind == "LabeledExpression":
