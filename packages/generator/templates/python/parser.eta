            literal = _units(node["text"])
            end = pos + len(literal) // 2
            if self.data[pos * 2:end * 2] == literal:
                return self.ok(node["text"], pos, end)
            mismatch = 0
            while mismatch < len(literal) and pos * 2 + mismatch < len(self.data) and self.data[pos * 2 + mismatch:pos * 2 + mismatch + 2] == literal[mismatch:mismatch + 2]:
                mismatch += 2
            return self.fail(pos + mismatch // 2, repr(node["text"]))
        if kind in ("AnyChar", "CharacterClass"):
            char, end = self.char(pos)
            matches = bool(char)
            if matches and kind == "CharacterClass":
                matches = any(low <= ord(char) <= high for low, high in node["ranges"]) != node["flag"]
            return self.ok(char, pos, end) if matches else self.fail(pos, "character" if kind == "AnyChar" else "character class")
        if kind == "Identifier":
            return self.rule(node["text"], pos, depth)
        if kind == "Sequence":
            end, committed, values, captures = pos, False, [], {}
            has_captures, scalar_capture = False, False
            for child in children:
                if _GRAMMAR["nodes"][child]["kind"] == "Cut":
                    committed = True
                    continue
                result = self.node(child, end, depth)
                if not result[0]:
                    if committed:
                        result = (False, dict(result[1], fatal=True))
                    return result
                end = result[3]
                if result[1] is not _IGNORED:
                    values.append(result[1])
                    scalar_capture = result[4]
                if result[4]:
                    has_captures = True
                    captures.update(result[1])
            if node["flag"] and has_captures:
                return self.ok(captures, pos, end)
            value = values[0] if node["min"] == 1 and not node["flag"] else values
            return self.ok(value, pos, end, scalar_capture if node["min"] == 1 and not node["flag"] else False)
        if kind == "Choice":
            best = self.fail(pos, "alternative")
            for child in children:
                result = self.node(child, pos, depth)
                if result[0] or result[1].get("abort"):
                    return result
                if result[1].get("fatal"):
                    return (False, {key: value for key, value in result[1].items() if key != "fatal"})
                if result[1]["pos"] > best[1]["pos"]:
                    best = result
                elif result[1]["pos"] == best[1]["pos"]:
                    best = (False, dict(result[1], expected=list(dict.fromkeys(best[1]["expected"] + result[1]["expected"]))))
            return best
        if kind == "WordBoundary":
            def word(offset):
                char, _ = self.char(offset) if offset >= 0 else ("", 0)
                return bool(char) and ("a" <= char <= "z" or "A" <= char <= "Z" or "0" <= char <= "9" or char == "_")
            boundary = word(pos - 1) != word(pos)
            return self.ok(None, pos, pos) if boundary != node["flag"] else self.fail(pos, "word boundary")
        if kind in ("Star", "Plus", "Quantified"):
            end, values = pos, []
            while node["max"] < 0 or len(values) < node["max"]:
                result = self.node(children[0], end, depth)
                if not result[0]:
                    if result[1].get("fatal") or len(values) < node["min"]:
                        return result
                    break
                values.append(result[1])
                if result[3] == end and node["max"] < 0:
                    return self.fail(end, "progress in repetition", True, True)
                end = result[3]
            return self.ok(values, pos, end)
        result = self.node(children[0], pos, depth)
