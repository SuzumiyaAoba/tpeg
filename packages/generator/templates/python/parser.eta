_IGNORED = object()


def _compile_transform(name, parameter, source):
    # Reindent tokens rather than lines: multiline string contents must
    # remain byte-for-byte intact when a body moves inside a function.
    body = list(_tokenize.generate_tokens(_io.StringIO(source).readline))
    trivia = {_tokenize.COMMENT, _tokenize.NL, _tokenize.NEWLINE,
              _tokenize.INDENT, _tokenize.DEDENT, _tokenize.ENDMARKER}
    first = next((token for token in body if token.type not in trivia), None)
    baseline = first.start[1] if first else 0
    tokens = [(_tokenize.NAME, "def"), (_tokenize.NAME, name),
              (_tokenize.OP, "("), (_tokenize.NAME, parameter),
              (_tokenize.OP, ")"), (_tokenize.OP, ":"),
              (_tokenize.NEWLINE, "\n"), (_tokenize.INDENT, "    ")]
    level = 0
    for token in body:
        kind, text = token.type, token.string
        if kind == _tokenize.ENDMARKER:
            continue
        if kind == _tokenize.INDENT:
            level += 1
            if baseline and level == 1:
                continue
            text = "    " + text[baseline:]
        elif kind == _tokenize.DEDENT:
            level -= 1
            if baseline and level == 0:
                continue
        tokens.append((kind, text))
    tokens.extend([(_tokenize.DEDENT, ""), (_tokenize.ENDMARKER, "")])
    namespace = {}
    exec(_tokenize.untokenize(tokens), globals(), namespace)
    return namespace[name]


def _units(text):
    return text.encode("utf-16-le", errors="surrogatepass")


def _text(data):
    return data.decode("utf-16-le", errors="surrogatepass")


class _Session:
    def __init__(self, text, transforms, max_depth):
        self.data = _units(text)
        self.length = len(self.data) // 2
        self.transforms = transforms
        self.max_depth = max_depth
        self.rules = {rule["name"]: rule for rule in _GRAMMAR["rules"]}
        self.memo = {}
        self.memo_order = {}

    def char(self, pos):
        if pos >= self.length:
            return "", pos
        first = int.from_bytes(self.data[pos * 2:pos * 2 + 2], "little")
        end = pos + 1
        if 0xD800 <= first <= 0xDBFF and end < self.length:
            second = int.from_bytes(self.data[end * 2:end * 2 + 2], "little")
            if 0xDC00 <= second <= 0xDFFF:
                end += 1
        return _text(self.data[pos * 2:end * 2]), end

    def ok(self, value, pos, end, capture=False):
        return (True, value, pos, end, capture)

    def fail(self, pos, expected, fatal=False, abort=False):
        found, _ = self.char(pos)
        error = {"pos": pos, "message": "Expected " + expected,
                 "expected": [expected], "found": found or "EOF"}
        if fatal:
            error["fatal"] = True
        if abort:
            error["abort"] = True
        return (False, error)

    def rule(self, name, pos, depth):
        rule = self.rules.get(name)
        if rule is None:
            return self.fail(pos, "rule " + name, True, True)
        key = (name, pos)
        if rule["memoize"] and key in self.memo:
            result = self.memo[key]
        else:
            result = self.node(rule["node"], pos, depth)
            if result[0]:
                result = self.ok(result[1], pos, result[3])
            if rule["memoize"]:
                self.memo[key] = result
                if rule["memoLimit"] >= 0:
                    order = self.memo_order.setdefault(name, _deque())
                    order.append(pos)
                    if len(order) > rule["memoLimit"]:
                        del self.memo[(name, order.popleft())]
        if result[0]:
            value = result[1]
            transform = self.transforms.get(name)
            if transform is not None:
                transformed = transform(value)
                if not transformed["success"]:
                    return self.fail(pos, str(transformed["error"]))
                value = transformed["value"]
            result = self.ok(value, pos, result[3])
        return result

    def node(self, index, pos, depth):
        if depth >= self.max_depth:
            return self.fail(pos, "maximum parse depth", True, True)
        depth += 1
        node = _GRAMMAR["nodes"][index]
        kind, children = node["kind"], node["children"]
