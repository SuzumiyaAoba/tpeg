func (s *parseSession) failure(pos int, expected string, fatal, abort bool) Result {
    found := "EOF"
    if pos < len(s.input) { char, _ := s.char(pos); found = string(char) }
    return Result{Error: &ParseError{Pos: pos, Message: "Expected " + expected, Expected: []string{expected}, Found: found, Fatal: fatal, Abort: abort}}
}

func (s *parseSession) rule(name string, pos, depth int) Result {
    info, exists := rules[name]
