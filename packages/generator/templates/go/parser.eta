    if settings.Offset < 0 || settings.Offset > len(session.input) { return session.failure(0, "valid input offset", true, true) }
    if settings.Offset > 0 && settings.Offset < len(session.input) && session.input[settings.Offset] >= 0xDC00 && session.input[settings.Offset] <= 0xDFFF && session.input[settings.Offset - 1] >= 0xD800 && session.input[settings.Offset - 1] <= 0xDBFF { return session.failure(settings.Offset, "code point boundary", true, true) }
    result := session.rule(settings.Rule, settings.Offset, 0)
    if result.Success && settings.Complete && result.Next != len(session.input) { return session.failure(result.Next, "end of input", false, false) }
    return result
}
