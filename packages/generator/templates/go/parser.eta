// <%~ it.parseName %> parses the start rule unless Options.Rule selects another.
// Positions use UTF-16 offsets. Set Complete to require end of input.
func <%~ it.parseName %>(input string, options ...ParseOptions) Result {
    settings := ParseOptions{}
