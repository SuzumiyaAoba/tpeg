type ParseError struct {
    Pos int `json:"pos"`
    Message string `json:"message"`
    Expected []string `json:"expected"`
    Found string `json:"found"`
    Fatal bool `json:"fatal,omitempty"`
    Abort bool `json:"abort,omitempty"`
}

type Result struct {
    Success bool
    Val any
    Current, Next int
    Error *ParseError
    captured, ignored bool
}

func (r Result) MarshalJSON() ([]byte, error) {
    if r.Success {
        return json.Marshal(map[string]any{"success": true, "val": r.Val, "current": r.Current, "next": r.Next})
    }
    return json.Marshal(map[string]any{"success": false, "error": r.Error})
}

type TransformResult struct { Success bool; Value any; Error string }
type Transform func(any) TransformResult

type ParseOptions struct {
    Rule string
    Offset int
    Complete bool
    MaxDepth int
