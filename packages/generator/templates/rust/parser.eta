#[derive(Clone, Debug, PartialEq)]
pub enum Value { Null, String(String), Array(Vec<Value>), Object(BTreeMap<String, Value>), Bool(bool), Number(f64) }

fn json_string(value: &str) -> String {
    let mut result = String::from("\"");
    for ch in value.chars() {
        match ch {
            '"' => result.push_str("\\\""), '\\' => result.push_str("\\\\"),
            '\n' => result.push_str("\\n"), '\r' => result.push_str("\\r"), '\t' => result.push_str("\\t"),
            ch if (ch as u32) < 32 => result.push_str(&format!("\\u{:04x}", ch as u32)),
            ch => result.push(ch),
        }
    }
    result.push('"'); result
}

impl Value {
    pub fn to_json(&self) -> String {
        match self {
            Value::Null => "null".into(),
            Value::String(value) => json_string(value),
            Value::Bool(value) => value.to_string(),
            Value::Number(value) => if value.is_finite() { value.to_string() } else { "null".into() },
            Value::Array(values) => format!("[{}]", values.iter().map(Value::to_json).collect::<Vec<_>>().join(",")),
            Value::Object(values) => format!("{{{}}}", values.iter().map(|(key, value)| format!("{}:{}", json_string(key), value.to_json())).collect::<Vec<_>>().join(",")),
        }
    }
}

#[derive(Clone, Debug, PartialEq)]
pub struct ParseError { pub pos: usize, pub message: String, pub expected: Vec<String>, pub found: String, pub fatal: bool, pub abort: bool }

#[derive(Clone, Debug, PartialEq)]
pub struct ParseResult {
    pub success: bool, pub val: Value, pub current: usize, pub next: usize, pub error: Option<ParseError>,
    captured: bool, ignored: bool,
}

impl ParseResult {
    pub fn to_json(&self) -> String {
        if self.success { return format!("{{\"success\":true,\"val\":{},\"current\":{},\"next\":{}}}", self.val.to_json(), self.current, self.next); }
        let error = self.error.as_ref().expect("failed parse has an error");
        format!("{{\"success\":false,\"error\":{{\"pos\":{},\"message\":{},\"expected\":[{}],\"found\":{}{}{}}}}}",
            error.pos, json_string(&error.message), error.expected.iter().map(|value| json_string(value)).collect::<Vec<_>>().join(","), json_string(&error.found),
            if error.fatal { ",\"fatal\":true" } else { "" }, if error.abort { ",\"abort\":true" } else { "" })
    }
}

pub type Transform = fn(Value) -> Result<Value, String>;

pub struct ParseOptions {
    pub rule: Option<String>, pub offset: usize, pub complete: bool, pub max_depth: usize,
    pub transforms: BTreeMap<String, Transform>,
}

impl Default for ParseOptions {
    fn default() -> Self { Self { rule: None, offset: 0, complete: false, max_depth: 256, transforms: BTreeMap::new() } }
}

