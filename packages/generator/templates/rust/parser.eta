struct Session {
    input: Vec<u16>, memo: HashMap<(String, usize), ParseResult>, order: HashMap<String, VecDeque<usize>>, options: ParseOptions,
}

fn success(value: Value, pos: usize, end: usize) -> ParseResult {
    ParseResult { success: true, val: value, current: pos, next: end, error: None, captured: false, ignored: false }
}

impl Session {
    fn char_at(&self, pos: usize) -> (u32, usize) {
        if pos >= self.input.len() { return (0, pos); }
        let first = self.input[pos] as u32;
        if (0xD800..=0xDBFF).contains(&first) && pos + 1 < self.input.len() {
            let second = self.input[pos + 1] as u32;
            if (0xDC00..=0xDFFF).contains(&second) { return (0x10000 + ((first - 0xD800) << 10) + second - 0xDC00, pos + 2); }
        }
        (first, pos + 1)
    }

    fn failure(&self, pos: usize, expected: &str, fatal: bool, abort: bool) -> ParseResult {
        let found = if pos >= self.input.len() { "EOF".into() } else { let (_, end) = self.char_at(pos); String::from_utf16_lossy(&self.input[pos..end]) };
        ParseResult { success: false, val: Value::Null, current: pos, next: pos, captured: false, ignored: false,
            error: Some(ParseError { pos, message: format!("Expected {}", expected), expected: vec![expected.into()], found, fatal, abort }) }
    }

    fn rule(&mut self, name: &str, pos: usize, depth: usize) -> ParseResult {
        let (node, memoize, limit) = match rule_info(name) { Some(info) => info, None => return self.failure(pos, &format!("rule {}", name), true, true) };
        let key = (name.to_owned(), pos);
        let cached = if memoize { self.memo.get(&key).cloned() } else { None };
        let mut result = match cached {
            Some(result) => result,
            None => {
                let mut result = self.node(node, pos, depth);
                result.captured = false;
                if memoize {
                    self.memo.insert(key, result.clone());
                    if limit >= 0 {
                        let queue = self.order.entry(name.to_owned()).or_default();
                        queue.push_back(pos);
                        if queue.len() > limit as usize { let offset = queue.pop_front().unwrap(); self.memo.remove(&(name.to_owned(), offset)); }
                    }
                }
                result
            }
        };
        if result.success {
            if let Some(transform) = self.options.transforms.get(name).copied().or_else(|| default_transform(name)) {
                match transform(result.val) {
                    Ok(value) => result.val = value,
                    Err(message) => return self.failure(pos, &message, false, false),
                }
            }
            result.captured = false;
        }
        result
    }

    fn node(&mut self, index: usize, pos: usize, depth: usize) -> ParseResult {
        if depth >= self.options.max_depth { return self.failure(pos, "maximum parse depth", true, true); }
        let depth = depth + 1;
        let n = NODES[index];
        match n.kind {
            "StringLiteral" => {
                for (offset, unit) in n.literal.iter().enumerate() {
                    if self.input.get(pos + offset) != Some(unit) { return self.failure(pos + offset, &json_string(&String::from_utf16_lossy(n.literal)), false, false); }
                }
                return success(Value::String(String::from_utf16_lossy(n.literal)), pos, pos + n.literal.len());
            }
            "AnyChar" | "CharacterClass" => {
                if pos >= self.input.len() { return self.failure(pos, "character", false, false); }
                let (ch, end) = self.char_at(pos);
                if n.kind == "AnyChar" || n.ranges.iter().any(|&(low, high)| low <= ch && ch <= high) != n.flag {
                    return success(Value::String(String::from_utf16_lossy(&self.input[pos..end])), pos, end);
                }
                return self.failure(pos, "character class", false, false);
            }
            "Identifier" => return self.rule(n.text, pos, depth),
            "Sequence" => {
                let (mut end, mut committed, mut has_captures, mut scalar_capture) = (pos, false, false, false);
                let mut values = Vec::new();
                let mut captures = BTreeMap::new();
                for &child in n.children {
                    if NODES[child].kind == "Cut" { committed = true; continue; }
                    let mut result = self.node(child, end, depth);
                    if !result.success { if committed { result.error.as_mut().unwrap().fatal = true; } return result; }
                    end = result.next;
                    if result.captured {
                        if let Value::Object(fields) = &result.val { has_captures = true; captures.extend(fields.clone()); }
                    }
                    if !result.ignored { scalar_capture = result.captured; values.push(result.val); }
                }
                if n.flag && has_captures { return success(Value::Object(captures), pos, end); }
                if n.min == 1 && !n.flag { let mut result = success(values.remove(0), pos, end); result.captured = scalar_capture; return result; }
                return success(Value::Array(values), pos, end);
            }
            "Choice" => {
                let mut best = self.failure(pos, "alternative", false, false);
                for &child in n.children {
                    let mut result = self.node(child, pos, depth);
                    if result.success || result.error.as_ref().unwrap().abort { return result; }
                    let error = result.error.as_mut().unwrap();
                    if error.fatal { error.fatal = false; return result; }
                    let old = best.error.as_ref().unwrap();
                    if error.pos > old.pos { best = result; }
                    else if error.pos == old.pos {
                        let mut expected = old.expected.clone();
                        for value in &error.expected { if !expected.contains(value) { expected.push(value.clone()); } }
                        error.expected = expected; best = result;
                    }
                }
                return best;
            }
            "WordBoundary" => {
                let word = |offset: Option<usize>| -> bool { offset.and_then(|offset| self.input.get(offset)).map_or(false, |&ch| (65..=90).contains(&ch) || (97..=122).contains(&ch) || (48..=57).contains(&ch) || ch == 95) };
                if (word(pos.checked_sub(1)) != word(Some(pos))) != n.flag { return success(Value::Null, pos, pos); }
                return self.failure(pos, "word boundary", false, false);
            }
            "Star" | "Plus" | "Quantified" => {
                let (mut end, mut values) = (pos, Vec::new());
                while n.max < 0 || values.len() < n.max as usize {
                    let result = self.node(n.children[0], end, depth);
                    if !result.success {
                        if result.error.as_ref().unwrap().fatal || values.len() < n.min { return result; }
                        break;
                    }
                    values.push(result.val);
                    if result.next == end && n.max < 0 { return self.failure(end, "progress in repetition", true, true); }
                    end = result.next;
                }
                return success(Value::Array(values), pos, end);
            }
            _ => (),
        }
        let mut result = self.node(n.children[0], pos, depth);
        match n.kind {
            "Optional" | "Skip" => {
                if !result.success { if result.error.as_ref().unwrap().fatal { return result; } result = success(Value::Null, pos, pos); }
                if n.kind == "Skip" { result.val = Value::Null; result.ignored = true; result.captured = false; }
                return result;
            }
            "PositiveLookahead" | "NegativeLookahead" => {
                if !result.success && result.error.as_ref().unwrap().abort { return result; }
                if result.success == (n.kind == "PositiveLookahead") { return success(Value::Null, pos, pos); }
                return if n.kind == "PositiveLookahead" { result.error.as_mut().unwrap().fatal = false; result } else { self.failure(pos, "negative lookahead", false, false) };
            }
            _ => (),
        }
        if !result.success { return result; }
        if n.kind == "Span" { return success(Value::String(String::from_utf16_lossy(&self.input[pos..result.next])), pos, result.next); }
        if n.kind == "LabeledExpression" { result.val = Value::Object(BTreeMap::from([(n.text.to_owned(), result.val)])); result.captured = true; }
        result
    }
}

/// Parse the start rule. All positions use UTF-16 offsets.
pub fn <%~ it.parseName %>(input: &str) -> ParseResult { <%~ it.parseName %>_with_options(input, ParseOptions::default()) }

/// Select a rule, offset, transforms, depth limit, and whole-input matching.
pub fn <%~ it.parseName %>_with_options(input: &str, options: ParseOptions) -> ParseResult {
    let name = options.rule.clone().unwrap_or_else(|| <%~ it.start %>.into());
    let pos = options.offset;
    let mut session = Session { input: input.encode_utf16().collect(), options, memo: HashMap::new(), order: HashMap::new() };
    if pos > session.input.len() { return session.failure(0, "valid input offset", true, true); }
    if pos > 0 && pos < session.input.len() && (0xDC00..=0xDFFF).contains(&session.input[pos]) && (0xD800..=0xDBFF).contains(&session.input[pos - 1]) { return session.failure(pos, "code point boundary", true, true); }
    let result = session.rule(&name, pos, 0);
    if result.success && session.options.complete && result.next != session.input.len() { return session.failure(result.next, "end of input", false, false); }
    result
}
