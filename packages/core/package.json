{
  "name": "@suzumiyaaoba/tpeg-core",
  "version": "0.1.0",
  "description": "Core types and utilities for tpeg PEG parser",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "cd ../.. && vp test packages/core",
    "test:watch": "cd ../.. && vp test watch packages/core",
    "test:coverage": "cd ../.. && vp test run packages/core --coverage",
    "test:ci": "cd ../.. && vp test run packages/core --reporter=verbose --bail=1",
    "test:grep": "cd ../.. && vp test run packages/core -t",
    "typecheck": "tsc --noEmit",
    "build": "cd ../.. && vp -C packages/core pack"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest"
  }
}
