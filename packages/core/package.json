{
  "name": "@suzumiyaaoba/tpeg-core",
  "type": "module",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "package.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "cd ../.. && vp test packages/core",
    "test:watch": "cd ../.. && vp test watch packages/core",
    "test:coverage": "cd ../.. && vp test run packages/core --coverage",
    "test:ci": "cd ../.. && vp test run packages/core --reporter=verbose --bail=1",
    "test:grep": "cd ../.. && vp test run packages/core -t",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:types && bun build --target=node --sourcemap ./index.ts --outdir=./dist",
    "build:types": "tsc --project ./tsconfig.build.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest"
  },
  "description": "Core types and utilities for tpeg PEG parser",
  "license": "MIT",
  "sideEffects": false
}
