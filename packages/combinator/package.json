{
  "name": "@suzumiyaaoba/tpeg-combinator",
  "version": "0.0.2",
  "license": "MIT",
  "files": [
    "*.ts",
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "module": "index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bun run ./index.ts",
    "typecheck": "tsc --noEmit",
    "build": "cd ../.. && vp -C packages/combinator pack",
    "benchmark": "cd ../.. && bunx vitest run packages/combinator/benchmark.spec.ts --config packages/combinator/vite.config.ts"
  },
  "dependencies": {
    "@suzumiyaaoba/tpeg-core": "workspace:*"
  }
}
