{
  "name": "@suzumiyaaoba/tpeg-samples",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run ./src/index.ts",
    "samples": "bun run ./src/index.ts",
    "csv": "bun run ./src/csv/demo.ts",
    "json": "bun run ./src/json/demo.ts",
    "peg": "bun run ./src/peg/demo.ts",
    "arith": "bun run ./src/arith/demo.ts",
    "arith:examples": "bun run ./src/arith/demo.ts --examples",
    "arith:repl": "bun run ./src/arith/repl.ts",
    "arith:test": "cd ../.. && vp test packages/samples/src/arith/calculator.spec.ts",
    "ini": "bun run ./src/ini/demo.ts",
    "sexpr": "bun run ./src/sexpr/demo.ts",
    "url": "bun run ./src/url/demo.ts",
    "codegen": "bun run ./src/codegen/demo.ts",
    "codegen:regen": "bun run ./src/codegen/demo.ts --generate-only",
    "test": "cd ../.. && vp test packages/samples",
    "test:watch": "cd ../.. && vp test watch packages/samples",
    "typecheck": "tsc --noEmit",
    "build": "cd ../.. && vp -C packages/samples pack"
  },
  "dependencies": {
    "@suzumiyaaoba/tpeg-combinator": "workspace:*",
    "@suzumiyaaoba/tpeg-core": "workspace:*",
    "@suzumiyaaoba/tpeg-parser": "workspace:*"
  }
}
