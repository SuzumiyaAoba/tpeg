grammar TPEGSelf {
  @description: "TPEG's own grammar syntax, defined using TPEG itself"

  grammar_def = leading "grammar" gap grammar_name gap "{" gap grammar_item* gap "}"

  leading = gap (comment gap)*

  grammar_name = identifier ("." identifier)*

  grammar_item = (comment / annotation / rule_def) gap

  comment = "//" (!"\n" .)*

  annotation = "@" identifier (":" inline_ws annotation_value)?
  annotation_value = string_literal / identifier

  rule_def = identifier inline_ws "=" inline_ws expression

  expression = choice_expr

  choice_expr = sequence_expr (inline_ws "/" inline_ws sequence_expr)*

  sequence_expr = labeled_expr (inline_ws labeled_expr)*

  labeled_expr = (identifier ":" postfix_expr) / postfix_expr

  postfix_expr = prefix_expr quantifier?

  prefix_expr = ("&" / "!")? primary_expr

  primary_expr = string_literal / character_class / any_char / group_expr / qualified_identifier / identifier

  group_expr = "(" inline_ws expression inline_ws ")"

  quantifier = "*" / "+" / "?" / brace_quantifier

  brace_quantifier = "{" number ("," number?)? "}"

  qualified_identifier = identifier "." identifier

  string_literal = double_quoted / single_quoted

  double_quoted = "\"" (escape_seq / [^"\\])* "\""

  single_quoted = "'" (escape_seq / [^'\\])* "'"

  escape_seq = "\\" ["\\ntr'\]]

  character_class = "[" "^"? char_range+ "]"

  char_range = (class_char "-" class_char) / class_char

  class_char = escape_seq / [^\]]

  any_char = "."

  identifier = [a-zA-Z_][a-zA-Z0-9_]*

  number = [0-9]+

  // Whitespace confined to a single line - keeps a rule's expression from
  // swallowing the next "identifier =" line, since every rule here is
  // written on one line (see self-hosting.spec.ts for the multi-line
  // caveat this implies).
  inline_ws = [ \t]*

  // Whitespace allowed to span lines, used only between structural
  // elements (around "{"/"}" and between whole rule definitions) where
  // there's no ambiguity with the start of the next rule.
  gap = [ \t\n\r]*
}
