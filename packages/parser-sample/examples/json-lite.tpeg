// JSON Lite Grammar Definition
// A simplified JSON parser for demonstration
grammar JsonLite {
  @version: "2.0"
  @author: "TPEG Team"
  @description: "Lightweight JSON parser"
  @license: "MIT"

  // Main JSON value types (whitespace-tolerant)
  value = whitespace (string / number / boolean / nullLiteral / object / array) whitespace

  // String parsing with escape sequences
  string = "\"" [^\"]* "\""

  // Number parsing (integers and floats)
  number = [0-9]+ ("." [0-9]+)?

  // Boolean literals
  boolean = "true" / "false"

  // Null literal
  nullLiteral = "null"

  // Object structure
  object = "{" whitespace (pair ("," whitespace pair)*)? "}"
  pair = string whitespace ":" value

  // Array structure (elements carry their own whitespace via `value`)
  array = "[" whitespace (value ("," value)*)? "]"

  // Insignificant whitespace
  whitespace = [ \t\n\r]*
}
