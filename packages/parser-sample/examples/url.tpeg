grammar URL {
  @version: "1.1"
  @description: "HTTP/HTTPS URL parser with components"
  @author: "TPEG Parser"
  @license: "MIT"

  url = scheme "://" host (":" port)? ("/" path)? ("?" query)? ("#" fragment)?
  scheme = "https" / "http"
  host = [a-zA-Z0-9.\-]+
  port = [0-9]+
  path = [a-zA-Z0-9_./\-]+
  query = [a-zA-Z0-9_&=%.\-]+
  fragment = [a-zA-Z0-9_.\-]+
}
