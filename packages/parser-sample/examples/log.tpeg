grammar Log {
  @version: "1.0"
  @description: "Application log file parser with timestamps and levels"
  @author: "TPEG Parser"
  @license: "MIT"

  log = logEntry ("\n" logEntry)* "\n"?
  logEntry = timestamp " " level " " message
  timestamp = isoTimestamp / commonTimestamp
  isoTimestamp = date "T" time ("." [0-9]+)? ("Z" / ("+" / "-") [0-9]+ ":" [0-9]+)?
  commonTimestamp = date " " time
  date = [0-9]+ ("-" / "/") [0-9]+ ("-" / "/") [0-9]+
  time = [0-9]+ ":" [0-9]+ ":" [0-9]+
  level = "ERROR" / "WARN" / "INFO" / "DEBUG" / "TRACE"
  message = [^\n]+
}
