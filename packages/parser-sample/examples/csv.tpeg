grammar CSV {
  @version: "1.0"
  @description: "CSV parser with quoted fields and escape sequences"
  @author: "TPEG Parser"
  @license: "MIT"

  csv = row (newline row)* newline?
  row = field ("," field)*
  field = quotedField / unquotedField
  quotedField = "\"" quotedChar* "\""
  quotedChar = "\"\"" / [^\"\n]
  unquotedField = [^",\n]*
  newline = "\n"
}
