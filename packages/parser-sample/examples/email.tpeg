grammar Email {
  @version: "1.0"
  @description: "Email address parser with basic validation"
  @author: "TPEG Parser Demo"
  @license: "MIT"

  email = localPart "@" domain
  localPart = (alphaNum / "." / "_" / "-")+
  domain = domainPart ("." domainPart)*
  domainPart = (alphaNum / "-")+
  alphaNum = alpha / digit
  alpha = [a-zA-Z]
  digit = [0-9]
}
