grammar INI {
  @version: "1.0"
  @description: "INI configuration file parser"
  @author: "TPEG Parser"
  @license: "MIT"

  ini = line ("\n" line?)* "\n"?
  line = section / property / comment / blankLine
  blankLine = [ \t]+
  section = "[" sectionName "]"
  sectionName = [a-zA-Z0-9_]+
  property = key "=" value
  key = [a-zA-Z0-9_]+
  value = [a-zA-Z0-9._/\-]+
  comment = (";" / "#") [^\n]*
}
