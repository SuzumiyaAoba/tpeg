{
  "name": "@suzumiyaaoba/tpeg-cli",
  "version": "0.1.0",
  "description": "Command-line interface for generating TypeScript parsers from TPEG grammar files",
  "type": "module",
  "bin": {
    "tpeg": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "package.json"],
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suzumiyaaoba/tpeg-core": "workspace:*",
    "@suzumiyaaoba/tpeg-parser": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "keywords": ["tpeg", "cli", "parser", "peg", "code-generation", "typescript"],
  "author": "SuzumiyaAoba",
  "license": "MIT"
}
