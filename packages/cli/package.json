{
  "name": "@suzumiyaaoba/tpeg-cli",
  "version": "0.1.0",
  "description": "Command-line interface for generating TypeScript parsers from TPEG grammar files",
  "keywords": [
    "cli",
    "code-generation",
    "parser",
    "peg",
    "tpeg",
    "typescript"
  ],
  "license": "MIT",
  "author": "SuzumiyaAoba",
  "bin": {
    "tpeg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "dev": "bun run src/cli.ts",
    "test": "cd ../.. && vp test packages/cli",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suzumiyaaoba/tpeg-core": "workspace:*",
    "@suzumiyaaoba/tpeg-parser": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
