{
  "name": "@suzumiyaaoba/tpeg-parser",
  "version": "0.1.0",
  "description": "TPEG Grammar Parser - implements parsing functionality for TPEG grammar syntax",
  "keywords": [
    "grammar",
    "parser",
    "parsing",
    "peg",
    "tpeg",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuzumiyaAoba/tpeg.git",
    "directory": "packages/parser"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "cd ../.. && vp -C packages/parser pack",
    "test": "cd ../.. && vp test packages/parser",
    "test:watch": "cd ../.. && vp test watch packages/parser",
    "typecheck": "tsc --noEmit && tsc --noEmit -p bench/tsconfig.json",
    "clean": "rm -rf dist",
    "bench": "bun --expose-gc run bench/run.ts"
  },
  "dependencies": {
    "@suzumiyaaoba/tpeg-combinator": "workspace:*",
    "@suzumiyaaoba/tpeg-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
