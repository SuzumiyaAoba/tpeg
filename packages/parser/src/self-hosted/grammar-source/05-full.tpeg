grammar SelfHostFull {
  // ---- Leaf constructs (same as 04-grammar.tpeg) ----

  // Mirrors escape-sequence.ts's namedEscapeSequence -- the same named
  // set in every context (previously strings only had n/r/t).
  namedEscape = "\\" c:[nrtbfv0] {
    if (c === "n") return "\n"; if (c === "r") return "\r"; if (c === "t") return "\t";
    if (c === "b") return "\b"; if (c === "f") return "\f"; if (c === "v") return "\v";
    return "\0";
  }

  // Mirrors numericEscapeSequence. unicodeBracedEscape's throw plays the
  // same role as the hand parser's fatal+abort rejection -- callers
  // treat a thrown action like a fatal failure (charRangePair below
  // already relies on this).
  unicodeBracedEscape = "\\u{" digits:[0-9a-fA-F]{1,6} "}" {
    const cp = parseInt(digits.join(""), 16);
    if (cp > 0x10ffff) throw new Error("Invalid Unicode code point: \\u{" + digits.join("") + "} is above U+10FFFF");
    return String.fromCodePoint(cp);
  }

  unicodeEscape4 = "\\u" digits:[0-9a-fA-F]{4} { return String.fromCodePoint(parseInt(digits.join(""), 16)); }

  hexEscape = "\\x" digits:[0-9a-fA-F]{2} { return String.fromCodePoint(parseInt(digits.join(""), 16)); }

  numericEscape = unicodeBracedEscape / unicodeEscape4 / hexEscape

  // Literal escapes differ per context (a `"` inside a string, a `]` or
  // `-` inside a class) -- same split as literalEscapeSequence.
  stringLiteralEscape = "\\" c:["'\\] { return c; }
  classLiteralEscape = "\\" c:[\]\\\^\-"'] { return c; }

  escapeChar = namedEscape / numericEscape / stringLiteralEscape

  doubleStringChar = escapeChar / [^"\\]

  singleStringChar = escapeChar / [^'\\]

  doubleQuotedString = "\"" chars:doubleStringChar* "\"" { return { type: "StringLiteral", value: chars.join(""), quote: '"' }; }

  singleQuotedString = "'" chars:singleStringChar* "'" { return { type: "StringLiteral", value: chars.join(""), quote: "'" }; }

  stringLiteralNode = doubleQuotedString / singleQuotedString

  classEscape = namedEscape / numericEscape / classLiteralEscape

  classChar = classEscape / [^\]\\\-]

  // Mirrors character-class.ts's charRange check: a backwards range like
  // [z-a] is rejected (there is no backtracking-out for a return-based
  // action, so this throws -- callers treat a thrown action the same way
  // they treat the hand-written parser's fatal failure: the input is
  // rejected either way).
  charRangePair = start:classChar "-" end:classChar {
    if ((start.codePointAt(0) ?? 0) > (end.codePointAt(0) ?? 0)) {
      throw new Error("Invalid character range: \"" + start + "-" + end + "\" (start must not be greater than end)");
    }
    return { start, end };
  }

  charRangeSingle = start:classChar { return { start }; }

  charRange = charRangePair / charRangeSingle

  characterClassBrackets = "[" negation:"^"? ranges:charRange+ "]" { return { type: "CharacterClass", ranges, negated: negation !== null }; }

  anyCharDot = "." { return { type: "AnyChar" }; }

  characterClassNode = characterClassBrackets / anyCharDot

  identStart = [a-zA-Z_]
  identContChar = [a-zA-Z0-9_]
  identCont = identContChar*

  identifierName = start:identStart rest:identCont { return start + rest.join(""); }

  identifierNode = name:identifierName { return { type: "Identifier", name }; }

  qualifiedIdentifierNode = module:identifierName "." name:identifierName ~ !("." identStart) { return { type: "QualifiedIdentifier", module, name }; }

  // Word-boundary assertions -- mirrors word-boundary.ts's
  // wordBoundaryMarker leaf: a bare `\b`/`\B` at expression level is a
  // zero-width assertion. An escaped `\b` INSIDE a string or character
  // class stays the backspace escape (handled by namedEscape above), so
  // this alternative only ever sees the assertion syntax.
  wordBoundaryNode = "\\" c:[bB] { return { type: "WordBoundary", negated: c === "B" }; }

  basicSyntax = stringLiteralNode / characterClassNode / qualifiedIdentifierNode / identifierNode / wordBoundaryNode

  // ---- Semantic action / brace-balanced blocks (same as 04-grammar.tpeg) ----

  escapedActionChar = "\\" . { return "\\" + $$[1]; }

  doubleQuotedActionString = "\"" chars:(escapedActionChar / [^"\\])* "\"" { return '"' + chars.join("") + '"'; }

  singleQuotedActionString = "'" chars:(escapedActionChar / [^'\\])* "'" { return "'" + chars.join("") + "'"; }

  // A template literal's `${ ... }` interpolation is real JavaScript --
  // it can contain nested braces, strings, comments, regexes, and even
  // nested template literals -- so it is scanned with the same
  // actionContent machinery as a block body (mirroring brace-scanner.ts's
  // skipStringLiteral -> scanJsToBlockClose recursion). A bare `$` not
  // followed by `{` is ordinary template text (handled by the catch-all
  // char alternative below, which templateInterp's ordered choice shadows
  // only when "${" is literally present).
  templateInterp = "${" first:(w:wsAndComments re:actionRegexLiteral)? parts:actionContent* "}" {
    return "${" + (first ? first.w.join("") + first.re : "") + parts.join("") + "}";
  }

  // A plain template-text char -- needs its own rule (not an inline
  // `c:.` capture) so each element of `chars` is a STRING: a labeled
  // capture inside a sequence yields a `{c: ...}` object, which would
  // join as "[object Object]" instead of the character.
  templatePlainChar = !("`" / "\\") c:. { return c; }

  templateActionString = "`" chars:(escapedActionChar / templateInterp / templatePlainChar)* "`" { return "`" + chars.join("") + "`"; }

  actionStringLiteral = doubleQuotedActionString / singleQuotedActionString / templateActionString

  lineCommentChar = !("\n" / "\r") c:. { return c; }

  blockCommentChar = !"*/" c:. { return c; }

  actionLineComment = "//" chars:lineCommentChar* { return "//" + chars.join(""); }

  actionBlockComment = "/*" chars:blockCommentChar* "*/" { return "/*" + chars.join("") + "*/"; }

  // Regex literals (e.g. `/}/`, `/"/g`) inside action code, mirroring
  // brace-scanner.ts's scanRegexLiteral + exprExpected heuristic: a `/`
  // opens a regex only where a value is expected. Since a PEG cannot look
  // back at the previous token, each "value expected" context folds its
  // optional regex into a single item (actionOpRegex / actionKwRegex /
  // nestedActionBlock's tail / actionBlock's first), so a `/` reached at
  // an item boundary is always a division operator or comment.

  actionRegexEscaped = "\\" . { return "\\" + $$[1]; }

  actionRegexClassChar = actionRegexEscaped / !("]" / "\n" / "\r") c:. { return c; }

  actionRegexClass = "[" chars:actionRegexClassChar* "]" { return "[" + chars.join("") + "]"; }

  actionRegexBodyChar = actionRegexEscaped / actionRegexClass / !("/" / "[" / "\n" / "\r") c:. { return c; }

  // The `/` opening a regex can't be followed by `/` or `*` (those start
  // comments, which are checked before regexes -- same ordering as the
  // hand-written scanner).
  actionRegexLiteral = "/" !("/" / "*") body:actionRegexBodyChar* "/" flags:[a-z]* { return "/" + body.join("") + "/" + flags.join(""); }

  // Keywords after which a value -- and therefore a regex -- can start.
  // "instanceof" precedes "in" so the longer keyword wins the ordered
  // choice.
  actionRegexKeyword = "instanceof" / "await" / "case" / "default" / "delete" / "do" / "else" / "in" / "new" / "of" / "return" / "throw" / "typeof" / "void" / "yield"

  // A punctuator that can't end an operand: `)`/`]` end operands, quotes
  // start strings, `/` is handled by the comment/regex rules, `{`/`}` are
  // blocks, and identifier/digit/whitespace chars are covered elsewhere.
  actionOpChar = !(")" / "]" / "{" / "}" / "\"" / "'" / "`" / "/" / [A-Za-z0-9_$] / [ \t\n\r]) c:. { return c; }

  // Postfix `++`/`--` end an operand, so a following `/` is division.
  actionPostfix = "++" / "--"

  actionKwRegex = kw:actionRegexKeyword ![A-Za-z0-9_$] w:wsAndComments re:actionRegexLiteral { return kw + w.join("") + re; }

  actionOpRegex = op:actionOpChar w:wsAndComments re:actionRegexLiteral { return op + w.join("") + re; }

  // A `(...)` group inside action code: mirrors brace-scanner.ts's paren
  // tracking (each `(` nests, and strings/comments/regexes/nested blocks
  // inside still apply) so the `)` ending a statement keyword's header can
  // be recognized as a position where a value -- and therefore a regex --
  // is expected next (`if (x) /}/.test(y)`). `(` immediately after the
  // opening paren is "value expected" too, so a leading regex is allowed
  // (`( /re/.exec(s) )`), same as actionBlock's own `first` slot.
  actionParenPlainChar = !("{" / "}" / "(" / ")") c:. { return c; }

  actionParenItem = nestedActionBlock / actionStringLiteral / actionLineComment / actionBlockComment / actionPostfix / actionKwRegex / actionOpRegex / actionStmtParenRegex / actionParenGroup / actionIdentifier / actionParenPlainChar

  actionParenGroup = "(" first:(w:wsAndComments re:actionRegexLiteral)? parts:actionParenItem* ")" {
    return "(" + (first ? first.w.join("") + first.re : "") + parts.join("") + ")";
  }

  // Statement keywords whose parenthesized header restores "value
  // expected" at the closing `)` -- brace-scanner.ts's STMT_PAREN_KEYWORDS.
  actionStmtParenKeyword = "catch" / "switch" / "while" / "with" / "for" / "if"

  // The whole `kw (...) /re/` shape folds into one rule (a PEG has no
  // lookbehind) -- same technique as actionKwRegex/actionOpRegex. When no
  // regex follows (`if (x) doThing()`), the rule fails and `if` falls
  // through to actionIdentifier like any other keyword.
  actionStmtParenRegex = kw:actionStmtParenKeyword ![A-Za-z0-9_$] w1:wsAndComments g:actionParenGroup w2:wsAndComments re:actionRegexLiteral {
    return kw + w1.join("") + g + w2.join("") + re;
  }

  // A nested `{ ... }` block ends a statement, so it may be followed by a
  // regex literal (matching the hand-written scanner's `}` -> value
  // expected rule).
  nestedActionBlock = inner:actionBlock tail:(w:wsAndComments re:actionRegexLiteral)? { return "{" + inner + "}" + (tail ? tail.w.join("") + tail.re : ""); }

  // Whole identifiers are consumed atomically so a keyword can't match
  // mid-word (e.g. the "return" inside "xreturn").
  actionIdentifier = h:[A-Za-z_$] t:[A-Za-z0-9_$]* { return h + t.join(""); }

  actionPlainChar = !("{" / "}") c:. { return c; }

  actionContent = nestedActionBlock / actionStringLiteral / actionLineComment / actionBlockComment / actionPostfix / actionKwRegex / actionOpRegex / actionStmtParenRegex / actionIdentifier / actionPlainChar

  // At the start of a block a value is expected, so a leading regex is
  // allowed (`{ /re/.test(x) }`).
  actionBlock = "{" first:(w:wsAndComments re:actionRegexLiteral)? parts:actionContent* "}" { return (first ? first.w.join("") + first.re : "") + parts.join(""); }

  // ---- Composition operators (same as 04-grammar.tpeg) ----

  interWs = [ \t\n\r]*
  interWsPlus = [ \t\n\r]+

  // Whitespace AND comments -- mirrors the hand-written parser's
  // optionalWhitespaceOrComment (whitespace-utils.ts), which
  // ruleDefinition uses between a rule's name and its "=" (so
  // `y\n= "b"` and `y /* c */ = "b"` are both rule starts, not
  // sequence continuations).
  wsAndComments = ([ \t\n\r] / actionLineComment / actionBlockComment)*

  // A `///` documentation line as a TAGGED value ({ doc }) so a leading
  // trivia run can collect it instead of discarding it -- mirrors
  // transforms.ts's docCollectingSeparator. Tried before the `//`
  // alternative everywhere it appears (a `///` line also starts with
  // `//`, same shadowing reason as grammar.ts's grammarItem).
  docCommentRaw = "///" chars:lineCommentChar* { return { doc: chars.join("").trim() }; }

  // optionalWhitespaceOrComment + `///` collection: whitespace and
  // comments are skipped like wsAndComments, but each `///` line yields a
  // { doc } element in the result array (whitespace/`//`/`/* */` elements
  // yield strings) so the caller can attach them as documentation.
  wsAndCommentsOrDocs = ([ \t\n\r] / docCommentRaw / actionLineComment / actionBlockComment)*

  // Required variant (requiredWhitespaceOrComment): at least one
  // whitespace/comment char -- a comment alone satisfies it, matching
  // the hand-written parser's separator positions (after "import",
  // around "as", ...).
  wsAndCommentsPlus = ([ \t\n\r] / actionLineComment / actionBlockComment)+

  group = "(" wsAndComments expr:choiceExpr wsAndComments ")" { return { type: "Group", expression: expr }; }

  primary = group / basicSyntax

  // Mirrors repetition.ts's positiveInt: a bound that overflows to
  // Infinity or loses integer precision is rejected (thrown, since an
  // action can't backtrack -- see charRangePair above).
  integer = digits:[0-9]+ {
    const text = digits.join("");
    const n = parseInt(text, 10);
    if (!Number.isSafeInteger(n)) {
      throw new Error("Invalid quantifier bound: {" + text + "} is not a safe integer");
    }
    return n;
  }

  // Mirrors repetition.ts's rangeCount: a reversed range like {5,2} is
  // rejected at parse time rather than crashing the generated parser's
  // `quantified()` at module load.
  quantifiedRange = "{" min:integer "," max:integer "}" {
    if (min > max) {
      throw new Error("Invalid quantifier range: {" + min + "," + max + "} (minimum must not be greater than maximum)");
    }
    return { min, max };
  }

  quantifiedMin = "{" min:integer "," "}" { return { min, max: undefined }; }

  quantifiedExact = "{" n:integer "}" { return { min: n, max: n }; }

  quantifiedOp = quantifiedRange / quantifiedMin / quantifiedExact

  starOp = expr:primary "*" { return { type: "Star", expression: expr }; }

  plusOp = expr:primary "+" { return { type: "Plus", expression: expr }; }

  optionalOp = expr:primary "?" { return { type: "Optional", expression: expr }; }

  quantOp = expr:primary q:quantifiedOp { return { type: "Quantified", expression: expr, min: q.min, max: q.max }; }

  // A syntactically valid `{n}`/`{n,}`/`{n,m}` shape -- used only as a
  // lookahead, so it stays purely syntactic (no integer/range validation;
  // `{5,2}` still matches here, and that's fine -- see postfixGuard).
  quantifierSuffix = "{" [0-9]+ ("," [0-9]*)? "}"

  // An ADJACENT "{...}" whose content is digits/commas/whitespace only is
  // a botched quantifier, not an action -- mirrors repetition.ts's
  // LOOKS_LIKE_MALFORMED_QUANTIFIER (`/^[\d,\s]*$/` on the scanned brace
  // content), covering `"a"{,3}` (missing minimum), `"a"{}` , and
  // `"a"{2,3,4}` (extra comma).
  adjacentMalformedQuantifier = "{" [0-9, \t\n\r\v\f]* "}"

  // Post-fix guards mirror the two checks withRepetition runs after a
  // postfix expression, in the same order:
  //   1. a SECOND valid repetition operator immediately after one that
  //      was already consumed (`"a"{2}{4}`, `"a"**`, `"a"?+`) is a parse
  //      error -- repetition operators don't chain;
  //   2. an adjacent "{...}" that isn't a valid operator but looks like a
  //      botched one (digits/commas/whitespace only) is rejected rather
  //      than reinterpreted as a semantic-action block by the
  //      alternative-level optional action.
  // Both must run for EVERY postfix result -- even a bare primary, since
  // `"a"{,3}` consumed no operator yet still must not treat `{,3}` as an
  // action. (When the base consumed no operator at all, guard 1 can never
  // fire anyway -- a valid operator would have been consumed by the op
  // rules -- so applying it unconditionally is safe.)
  postfix = expr:(starOp / plusOp / optionalOp / quantOp / primary)
            !("*" / "+" / "?" / quantifierSuffix)
            !adjacentMalformedQuantifier {
    return expr;
  }

  positiveLookahead = "&" expr:postfix { return { type: "PositiveLookahead", expression: expr }; }

  negativeLookahead = "!" expr:postfix { return { type: "NegativeLookahead", expression: expr }; }

  // `@expr` -- the source-span/text operator, a third prefix operator
  // alongside `&`/`!` (lookahead.ts's lookaheadOperator). Same
  // `postfix`-level operand as the lookaheads, and like them it can't
  // stack: `prefix` is a single ordered choice, so `@&x`/`!@x` don't
  // parse.
  //
  // The `!annotationStart` guard mirrors grammar.ts's
  // isAnnotationStartAt: a depth-0 `@` that begins an ANNOTATION ends
  // the enclosing rule's body there, so the span operator must refuse
  // exactly those `@`s. It lives inside spanOp -- not only in
  // `notNextRuleStart` -- because the hand-written scanner applies the
  // test to EVERY depth-0 `@` positionally: label operands (`w:@x`),
  // an alternative's first element after `/`, and group interiors all
  // get truncated the same way (the scanner counts BRACE depth, not
  // parens). `annotationStart` is defined below with notNextRuleStart.
  spanOp = !annotationStart "@" expr:postfix { return { type: "Span", expression: expr }; }

  prefix = positiveLookahead / negativeLookahead / spanOp / postfix

  labeled = label:identifierName wsAndComments ":" wsAndComments expr:prefix { return { type: "LabeledExpression", label, expression: expr }; }
          / prefix

  // A whole-word "transforms" can only start a new grammarItem (a transform
  // set definition) - mirrors the equivalent fix in grammar.ts's
  // grammarRuleExpression (see packages/parser/src/self-hosted/README.md).
  // The "!identContChar" guard keeps this narrowly the whole word, not a
  // prefix, so a rule legitimately named e.g. "transformsFoo" is unaffected.
  //
  // `!annotationStart` mirrors grammar.ts's isAnnotationStartAt: a `@`
  // that begins an ANNOTATION (`@key:`, `@key` before a rule header or
  // another annotation) ends the enclosing rule's body, while any other
  // `@` is the `@expr` span operator continuing the sequence. Only
  // `@` + identifier can be annotation-shaped at all (`@"`, `@[`, `@(`
  // are always spans); what settles it is the token AFTER that
  // identifier (trivia skipped): `:` or `@` can only follow an
  // annotation, and a rule boundary there (the next rule's `name =`, a
  // `transforms` block, or the grammar block's `}`) means the `@ident`
  // was a flag annotation preceding the next item -- e.g. `@noskip` in
  // `r = "a" @noskip\nx = "b"` ends `r`'s body. Any other continuation
  // (`@x "lit"`, `@x+`, end of input) is a span. Groups share
  // `sequenceContinuation`, and the hand-written scanner applies the
  // same test inside parens -- it counts BRACE depth (action/transform
  // bodies), not parens -- so guarding the shared continuation is
  // correct there too.
  annotationStart = "@" identifierName wsAndComments
                    (":" / "@" / identifierName wsAndComments "=" / "transforms" !identContChar / "}")

  notNextRuleStart = !(identifierName wsAndComments "=") !("transforms" !identContChar) !annotationStart

  // The `~` cut/commit marker is a sequence element of its own, mirroring
  // composition.ts's sequenceElement = choice(cutMarker, labeled) -- it is
  // tried first since `~` can't start a labeled expression anyway.
  cutMarkerNode = "~" { return { type: "Cut" }; }

  sequenceElementNode = cutMarkerNode / labeled

  sequenceContinuation = wsAndComments notNextRuleStart sequenceElementNode

  sequenceBase = first:sequenceElementNode rest:sequenceContinuation* {
    if (rest.length === 0) return first;
    const elements = [first, ...rest.map((r: any) => r[2])];
    return { type: "Sequence", elements };
  }

  // Optional trailing semantic action, mirroring composition.ts's
  // withOptionalAction: `whitespace` there is zero-or-more (comment
  // tolerant), so an action is accepted with ANY whitespace/comment gap --
  // including none at all (`"a"{return 1}` is a valid ActionExpression on
  // both sides; an adjacent `{...}` that LOOKS like a botched quantifier
  // was already rejected by the postfix guard above).
  //
  // The quantifier-shaped-body check mirrors QUANTIFIER_SHAPED_ACTION_BODY
  // (`/^\d+(,\d*)?$/` on the trimmed block content): `expr {2}` WITH a
  // space is a common typo for the no-space quantifier, and its body has
  // no `return`, so it would evaluate to `undefined` -- rejected (thrown,
  // like charRangePair) rather than silently accepted as an action.
  alternative = base:sequenceBase act:(wsAndComments code:actionBlock)? {
    if (act === null) return base;
    const code = act.code;
    if (/^\d+(,\d*)?$/.test(code.trim())) {
      throw new Error("Ambiguous \"{" + code + "}\" after an expression: this is a quantifier only when written with no space before \"{\"");
    }
    return { type: "ActionExpression", expression: base, code };
  }

  choiceExpr = first:alternative rest:(wsAndComments "/" wsAndComments alternative)* {
    if (rest.length === 0) return first;
    const alternatives = [first, ...rest.map((r: any) => r[3])];
    return { type: "Choice", alternatives };
  }

  // ---- Rule / grammar block structure (same as 04-grammar.tpeg) ----

  // `!annotationStart` mirrors the hand-written scanner treating an
  // annotation-shaped `@` as a boundary even at a body's very first
  // position: `r = @noskip\nx = "b"` truncates `r`'s body to nothing
  // there (a parse error), never a `Span(noskip)` body. A `@` that's
  // NOT annotation-shaped (`@"lit"`, `@(e)`, `@x "a"`) passes the guard
  // and parses as the span operator it is.
  ruleDefinitionNode = interWs name:identifierName wsAndComments "=" wsAndComments !annotationStart pattern:choiceExpr {
    return { type: "RuleDefinition", name, pattern };
  }

  annotationValue = quotedStringValue / identifierName

  // Keys with their own dedicated annotation syntax (grammar.ts's
  // DEDICATED_ANNOTATION_KEYS) -- the generic "@key: value"/"@key" forms
  // reject them (the `!dedicatedAnnotationKey` lookahead below), so a
  // MALFORMED dedicated annotation (e.g. `@export: "a"`, a quoted string
  // where the dedicated form wants `[names]`) surfaces as a parse error
  // instead of being silently swallowed as a generic annotation that
  // nothing downstream reads.
  dedicatedAnnotationKey = ("export" / "dependencies" / "conflicts" / "requires" / "memoize" / "noskip") !identContChar

  keyValueAnnotation = interWs "@" !dedicatedAnnotationKey key:identifierName interWs ":" interWs value:annotationValue {
    return { type: "GrammarAnnotation", key, value };
  }

  flagAnnotation = interWs "@" !dedicatedAnnotationKey key:identifierName {
    return { type: "GrammarAnnotation", key, value: "" };
  }

  grammarAnnotationNode = keyValueAnnotation / flagAnnotation

  // `@memoize`/`@memoize: N` before a rule attaches to the RULE's
  // `annotations`, not the grammar block's -- mirrors grammar.ts's
  // memoizeAnnotation + annotatedRuleDefinition (tried BEFORE the generic
  // grammarAnnotation: restricting the key to the literal "memoize" keeps
  // it from misattaching e.g. "@start: expression" to the following
  // rule). NOTE: no word-boundary check after "memoize", exactly like
  // the hand-written `literal("memoize")`.
  memoizeAnnotationNode = interWs "@" "memoize" v:(wsAndComments ":" wsAndComments digits:[0-9]+)? {
    return { type: "GrammarAnnotation", key: "memoize", value: v ? v.digits.join("") : "" };
  }

  // `@noskip` -- flag only, mirrors grammar.ts's noskipAnnotation (a
  // `DEDICATED_ANNOTATION_KEYS` member, so the generic alternatives above
  // refuse it and `@noskip` with no rule after it surfaces as a parse
  // error rather than an inert standalone annotation).
  noskipAnnotationNode = interWs "@" "noskip" {
    return { type: "GrammarAnnotation", key: "noskip", value: "" };
  }

  ruleLevelAnnotationNode = memoizeAnnotationNode / noskipAnnotationNode

  annotatedRuleNode = anns:ruleLevelAnnotationNode+ wsAndComments r:ruleDefinitionNode {
    return { ...r, annotations: anns };
  }

  singleLineCommentNode = "//" chars:lineCommentChar* { return { kind: "comment" }; }

  // `///` carries its trimmed text as a "documentation" item so the
  // grammar-block action can attach it to the next rule's `documentation`
  // field -- mirrors grammar.ts's documentationComment (which `///` would
  // otherwise never reach, shadowed by the `//` single-line alternative).
  docCommentNode = "///" chars:lineCommentChar* { return { kind: "documentation", value: chars.join("").trim() }; }

  blockCommentNode = "/*" chars:blockCommentChar* "*/" { return { kind: "comment" }; }

  // A run of whitespace and/or `//`/`///`/`/* */` comments, tolerant the
  // same way grammar.ts's `leadingContent` (before `import`/`grammar`
  // keywords) and `optionalWhitespaceOrComment` (between a grammar block's
  // header clauses and its opening "{") are - unlike interWs, which only
  // skips whitespace. Used at positions that aren't grammar items in their
  // own right (grammarItemNode's own comment alternatives cover the
  // between-items case), just skippable filler before a keyword/brace.
  leadingContentUnit = blockCommentNode / docCommentNode / singleLineCommentNode / interWsPlus

  leadingContent = leadingContentUnit*

  // ---- Module system: import / export / extends / includes / @dependencies /
  // @conflicts / @requires (docs/peg-grammar.md; packages/parser/src/module.ts,
  // grammar.ts's modularGrammarDefinition/tpegModuleFile) ----

  quotedStringValue = s:stringLiteralNode { return s.value; }

  importAlias = wsAndCommentsPlus "as" wsAndCommentsPlus name:identifierName { return name; }

  // Shared comma-separated-identifier-list core, reused (with a different
  // pair of surrounding brackets) by both selectiveImportList ("{...}") and
  // exportRuleList ("[...]") below.
  identifierCommaList = first:identifierName rest:(wsAndComments "," wsAndComments identifierName)* {
    return [first, ...rest.map((r: any) => r[3])];
  }

  selectiveImportList = "{" wsAndComments items:identifierCommaList? wsAndComments "}" {
    return items ?? [];
  }

  simpleImportNode = "import" wsAndCommentsPlus path:quotedStringValue alias:importAlias? {
    return { type: "ImportStatement", modulePath: path, alias: alias ?? undefined };
  }

  selectiveImportNode = "import" wsAndCommentsPlus path:quotedStringValue wsAndCommentsPlus selective:selectiveImportList {
    return { type: "ImportStatement", modulePath: path, selective };
  }

  versionedImportNode = "import" wsAndCommentsPlus path:quotedStringValue wsAndCommentsPlus "version" wsAndCommentsPlus version:quotedStringValue alias:importAlias? {
    return { type: "ImportStatement", modulePath: path, alias: alias ?? undefined, version };
  }

  // versioned must be tried before selective/simple: all three share the
  // "import <ws> path" prefix, and simple's grammar is a strict prefix of
  // versioned's, so trying simple first would match just the path and leave
  // "version ..."/"{ ... }" as unparsed trailing content.
  importStatementNode = versionedImportNode / selectiveImportNode / simpleImportNode

  exportRuleList = "[" wsAndComments items:identifierCommaList? wsAndComments "]" {
    return items ?? [];
  }

  // Matches the literal key "export" only (not any "@key: [...]"), same as
  // grammar.ts's exportDeclaration - this is why it must be tried before
  // moduleInfoListAnnotationNode below, which accepts any key. The `~`
  // cut after the whole-word boundary mirrors grammar.ts's
  // malformedExportAnnotation: once "@export" is seen, a failure in the
  // rest of the declaration is FATAL (a malformed `@export` is a parse
  // error, not a generic annotation). `@exportFoo` is a different key
  // entirely -- the `!identContChar` boundary check fails BEFORE the cut,
  // so it still falls through to the generic annotations.
  exportDeclarationNode = interWs "@export" !identContChar ~ wsAndComments ":" wsAndComments rules:exportRuleList {
    return { type: "ExportDeclaration", rules };
  }

  quotedStringList = "[" wsAndComments items:(stringLiteralNode (wsAndComments "," wsAndComments stringLiteralNode)*)? wsAndComments "]" {
    if (items === null) return [];
    const [first, rest] = items;
    return [first.value, ...rest.map((r: any) => r[3].value)];
  }

  // Generic "@key: [\"a\", \"b\"]" annotation (@dependencies/@conflicts) -
  // must be tried after exportDeclarationNode (see above) and before
  // grammarAnnotationNode (whose keyValueAnnotation alternative would
  // otherwise fail on the "[" value and fall through to flagAnnotation,
  // wrongly matching just "@key" and leaving ": [...]" dangling).
  // Mirrors module.ts's annotationKeyExcluding: every dedicated key OTHER
  // than this form's own (@dependencies/@conflicts) is rejected, so a
  // malformed `@export: ["a"]`-style misfire can't fall through here.
  moduleInfoListAnnotationNode = interWs "@" !(("export" / "requires" / "memoize" / "noskip") !identContChar) key:identifierName wsAndComments ":" wsAndComments values:quotedStringList {
    return { type: "ModuleInfoListAnnotation", key, values };
  }

  quotedStringRecordEntry = key:stringLiteralNode wsAndComments ":" wsAndComments value:stringLiteralNode { return [key.value, value.value]; }

  quotedStringRecord = "{" wsAndComments items:(quotedStringRecordEntry (wsAndComments "," wsAndComments quotedStringRecordEntry)*)? wsAndComments "}" {
    if (items === null) return {};
    const [first, rest] = items;
    return Object.fromEntries([first, ...rest.map((r: any) => r[3])]);
  }

  // Generic "@key: { \"a\": \"b\" }" annotation (@requires) - same ordering
  // rationale as moduleInfoListAnnotationNode above, and the same
  // reserved-key exclusion (every dedicated key except this form's own
  // @requires).
  moduleInfoRecordAnnotationNode = interWs "@" !(("export" / "dependencies" / "conflicts" / "memoize" / "noskip") !identContChar) key:identifierName wsAndComments ":" wsAndComments values:quotedStringRecord {
    return { type: "ModuleInfoRecordAnnotation", key, values };
  }

  dottedGrammarName = first:identifierName rest:("." identifierName)* {
    return [first, ...rest.map((r: any) => r[1])].join(".");
  }

  // Comment-tolerant separators mirror grammar.ts's
  // requiredWhitespaceOrComment/optionalWhitespaceOrComment (comments are
  // allowed between syntactic elements everywhere in the grammar spec) --
  // wsAndCommentsPlus/wsAndComments, not the whitespace-only
  // interWsPlus/interWs.
  grammarExtendsClause = "extends" wsAndCommentsPlus name:dottedGrammarName { return name; }

  grammarIncludesClause = "includes" wsAndCommentsPlus first:dottedGrammarName rest:(wsAndComments "," wsAndComments dottedGrammarName)* {
    return [first, ...rest.map((r: any) => r[3])];
  }

  // ---- Transform definitions: `transforms Name@language { fn()->T {...} }`
  // (packages/parser/src/transforms.ts) ----

  // Same six languages, same order, and the same "not a prefix of a longer
  // identifier" guard as transforms.ts's targetLanguage - notably the guard
  // only excludes a following [a-zA-Z0-9], NOT "_", matching that function's
  // TYPE_CHAR-less regex exactly (so "typescript_x" still parses as language
  // "typescript" here, same as in the hand-written parser).
  targetLanguageNode = lang:"typescript" !langChar { return lang; }
                     / lang:"python" !langChar { return lang; }
                     / lang:"go" !langChar { return lang; }
                     / lang:"rust" !langChar { return lang; }
                     / lang:"java" !langChar { return lang; }
                     / lang:"cpp" !langChar { return lang; }

  langChar = [a-zA-Z0-9]

  transformSetName = name:identifierName wsAndComments "@" wsAndComments lang:targetLanguageNode { return { name, language: lang }; }

  // ---- Type expressions in transform signatures (transforms.ts's
  // typeExpression): a union/intersection of postfix types; a postfix type
  // is a primary plus `[]` markers; a primary is an object-literal type
  // ("{...}" -- actionContent already skips strings/comments/nested braces,
  // same as transforms.ts's scanObjectType), a parenthesized type, or a
  // named type with optional `<args...>` (nested and multi-argument
  // generics included). Every rule returns `{ text, head? }`: `text` is the
  // exact source slice (inner whitespace preserved via the typeWs
  // captures), and `head` is set only when the whole type is exactly
  // `Name` or `Name<args>`, so returnTypeSpec keeps emitting
  // `{ type: "Result", generic: "number" }` for the common `Result<T>`
  // shape while unions/arrays/multi-arg generics are no longer truncated.
  // Separators INSIDE a type expression -- transforms.ts's
  // skipTypeWhitespace skips comments as well as whitespace (and the
  // comment text is part of the captured `text` slice, which is why the
  // comment alternatives' raw return values are joined in verbatim).
  typeWs = chars:([ \t\n\r] / actionLineComment / actionBlockComment)* { return chars.join(""); }

  typeObject = "{" parts:actionContent* "}" { return { text: "{" + parts.join("") + "}" }; }

  typeParen = "(" w1:typeWs inner:typeUnion w2:typeWs ")" {
    return { text: "(" + w1 + inner.text + w2 + ")" };
  }

  // The `~` cut after "<" mirrors the hand parser: once a `<` follows the
  // name, a malformed argument list fails the whole type (fatal) rather
  // than backtracking to a bare `Name` that leaves "<" dangling. Every
  // element inside the group is labeled so the captured object keeps the
  // whitespace pieces needed to rebuild the raw `generic` text (unlabeled
  // elements don't survive captureSequence's label merge).
  typeNamed = n:identifierName g:(w1:typeWs "<" ~ w2:typeWs a1:typeUnion arest:(c1:typeWs "," c2:typeWs a:typeUnion)* w3:typeWs ">")? {
    if (g === null) return { text: n, head: { name: n } };
    const p = g;
    let inner = p.w2 + p.a1.text;
    for (const r of p.arest) inner += r.c1 + "," + r.c2 + r.a.text;
    inner += p.w3;
    return { text: n + p.w1 + "<" + inner + ">", head: { name: n, generic: inner } };
  }

  typePrimary = typeObject / typeParen / typeNamed

  typePostfix = p:typePrimary arr:(typeWs "[" typeWs "]")* {
    let text = p.text;
    for (const a of arr) text += a[0] + "[" + a[2] + "]";
    return arr.length === 0 && p.head ? { text, head: p.head } : { text };
  }

  typeUnion = typeWs first:typePostfix rest:(typeWs ("|" / "&") typeWs typePostfix)* {
    let text = first.text;
    for (const r of rest) text += r[0] + r[1] + r[2] + r[3].text;
    return rest.length === 0 && first.head ? { text, head: first.head } : { text };
  }

  // Signature separators are comment-tolerant (transforms.ts's
  // optionalWhitespaceOrComment): `f(a /* c *\/: string)`, `f(a: string,
  // /* c *\/ b: number)`, `f() /* c *\/ -> /* c *\/ T` all parse.
  parameterType = name:identifierName wsAndComments ":" wsAndComments t:typeUnion {
    return { name, type: t.text, optional: false };
  }

  parameterList = "(" wsAndComments items:(parameterType (wsAndComments "," wsAndComments parameterType)*)? wsAndComments ")" {
    if (items === null) return [];
    const [first, rest] = items;
    return [first, ...rest.map((r: any) => r[3])];
  }

  returnTypeSpec = wsAndComments "->" wsAndComments t:typeUnion {
    return t.head
      ? (t.head.generic !== undefined ? { type: t.head.name, generic: t.head.generic } : { type: t.head.name })
      : { type: t.text };
  }

  // Leading trivia is wsAndCommentsOrDocs so `///` lines before a function
  // attach to its `documentation` field (transforms.ts's
  // docCollectingSeparator) instead of being discarded as plain comments.
  transformFunctionNode = trivia:wsAndCommentsOrDocs name:identifierName wsAndComments params:parameterList ret:returnTypeSpec wsAndComments body:actionBlock {
    const documentation = trivia.filter((t: any) => typeof t === "object" && t !== null).map((t: any) => t.doc);
    const fn: any = { name, parameters: params, returnType: ret, body };
    if (documentation.length > 0) fn.documentation = documentation;
    return fn;
  }

  // At least one function is required - "transforms T@typescript { }" fails
  // in the hand-written parser (transformFunctions never accepts zero), so
  // this uses first+rest rather than a bare star(). No separator between
  // functions on purpose: transformFunctionNode's own leading
  // wsAndCommentsOrDocs already skips trivia AND collects `///` docs --
  // a separate wsAndComments here would eat those doc lines before the
  // next function could see them (same reason transforms.ts peeks with
  // docCollectingSeparator instead of optionalWhitespaceOrComment).
  transformFunctions = first:transformFunctionNode rest:transformFunctionNode* {
    return [first, ...rest];
  }

  // No wsAndComments between "{" and transformFunctions -- the first
  // function's own wsAndCommentsOrDocs collects any `///` doc lines there;
  // a plain wsAndComments would discard them (see transformFunctions).
  transformDefinitionNode = wsAndComments "transforms" wsAndCommentsPlus info:transformSetName wsAndComments "{" functions:transformFunctions wsAndComments "}" {
    return {
      type: "TransformDefinition",
      transformSet: { name: info.name, targetLanguage: info.language, functions },
    };
  }

  // ---- Grammar item + block, extended with module/transform items ----
  //
  // Recognized-but-unimplemented annotation keys (grammar.ts's
  // unsupportedAnnotation / module.ts's UNIMPLEMENTED_ANNOTATION_KEYS):
  // rejected outright rather than parsed into an inert generic
  // annotation nothing reads. A semantic action has no backtrackable
  // failure channel, so the rejection is a thrown Error -- the same
  // "reject by throwing" technique the quantifier/range validation
  // actions use; compare specs normalize a throw to `success: false`,
  // matching the hand-written parser's fatal failure.
  // `!identContChar` keeps `@privateFoo` parsing as the generic flag
  // annotation it legitimately is.
  // Returns a sentinel item rather than throwing directly: an
  // unconditionally-throwing action would leave the generated wrapper's
  // trailing `return` unreachable (TS7027), so the grammarBlockNode/
  // modularGrammarBlockNode item loops below do the throwing once the
  // whole block has parsed.
  unsupportedAnnotationNode = interWs "@" key:("private" / "protected" / "public" / "internal" / "override" / "namespace" / "ifdef" / "ifndef" / "endif" / "elif" / "if" / "else") !identContChar {
    return { kind: "unsupportedAnnotation", key };
  }

  // Order matters and mirrors grammar.ts's grammarItem: export (literal
  // "@export" key) before the generic @-array/@-record annotations (any
  // key) before "@memoize"-annotated rules before the generic
  // @key:value/@key annotation, so a more specific alternative never gets
  // shadowed by a more permissive one tried first. unsupportedAnnotationNode
  // sits right after exportDeclarationNode (mirroring grammar.ts's
  // malformedExportAnnotation -> unsupportedAnnotation pair) so an
  // unimplemented key can never slip into a module-info list/record or
  // generic annotation it syntactically resembles.
  grammarItemNode = e:exportDeclarationNode { return { kind: "export", value: e }; }
                  / unsupportedAnnotationNode
                  / l:moduleInfoListAnnotationNode { return { kind: "moduleInfoList", key: l.key, values: l.values }; }
                  / r:moduleInfoRecordAnnotationNode { return { kind: "moduleInfoRecord", key: r.key, values: r.values }; }
                  / ar:annotatedRuleNode { return { kind: "rule", value: ar }; }
                  / a:grammarAnnotationNode { return { kind: "annotation", value: a }; }
                  / rule:ruleDefinitionNode { return { kind: "rule", value: rule }; }
                  / t:transformDefinitionNode { return { kind: "transform", value: t }; }
                  / d:docCommentNode { return d; }
                  / c:singleLineCommentNode { return { kind: "comment" }; }
                  / c:blockCommentNode { return { kind: "comment" }; }

  grammarItemWithWs = grammarItemNode interWs

  grammarItemsNode = interWs items:grammarItemWithWs* { return items.map((i: any) => i[0]); }

  modularGrammarBlockNode = leadingContent "grammar" interWsPlus name:dottedGrammarName leadingContent ext:grammarExtendsClause? leadingContent inc:grammarIncludesClause? leadingContent "{" items:grammarItemsNode interWs "}" {
    const annotations: any[] = [];
    const rules: any[] = [];
    const transforms: any[] = [];
    const exportedRules: string[] = [];
    let hasExport = false;
    const moduleInfoLists: Record<string, string[]> = {};
    const moduleInfoRecords: Record<string, Record<string, string>> = {};
    // `///` documentation items accumulate and attach to the next rule's
    // `documentation` field; any other item kind drops a pending run --
    // mirrors grammar.ts's separateGrammarItems.
    let pendingDocs: string[] = [];

    for (const i of items) {
      if (i.kind === "unsupportedAnnotation") {
        throw new Error(`Annotation "@${i.key}" is not implemented -- it is recognized by the grammar syntax but has no effect, so it is rejected rather than silently ignored`);
      }
      else if (i.kind === "annotation") { annotations.push(i.value); pendingDocs = []; }
      else if (i.kind === "rule") {
        rules.push(pendingDocs.length > 0 ? { ...i.value, documentation: pendingDocs } : i.value);
        pendingDocs = [];
      }
      else if (i.kind === "transform") { transforms.push(i.value); pendingDocs = []; }
      else if (i.kind === "export") { hasExport = true; exportedRules.push(...i.value.rules); pendingDocs = []; }
      else if (i.kind === "moduleInfoList") {
        moduleInfoLists[i.key] = [...(moduleInfoLists[i.key] ?? []), ...i.values];
        pendingDocs = [];
      } else if (i.kind === "moduleInfoRecord") {
        moduleInfoRecords[i.key] = { ...moduleInfoRecords[i.key], ...i.values };
        pendingDocs = [];
      } else if (i.kind === "documentation") pendingDocs.push(i.value);
      // "comment" -- ignored, and does not break a pending doc run
    }

    const version = annotations.find((a: any) => a.key === "version")?.value;
    const dependencies = moduleInfoLists["dependencies"];
    const conflicts = moduleInfoLists["conflicts"];
    const requires = moduleInfoRecords["requires"];

    const result: any = { type: "ModularGrammarDefinition", name, annotations, rules, transforms };

    if (hasExport) {
      result.exports = { type: "ExportDeclaration", rules: exportedRules };
    }
    if (version || dependencies || conflicts || requires) {
      const moduleInfo: any = { type: "ModuleInfo" };
      if (dependencies !== undefined) moduleInfo.dependencies = dependencies;
      if (conflicts !== undefined) moduleInfo.conflicts = conflicts;
      if (version !== undefined) moduleInfo.version = version;
      if (requires !== undefined) moduleInfo.requires = requires;
      result.moduleInfo = moduleInfo;
    }
    if (ext !== null) result.extends = ext;
    if (inc !== null) result.includes = inc;

    return result;
  }

  // A full `.tpeg` file: zero or more import statements followed by a single
  // (possibly modular) grammar block, then any trailing `transforms` blocks
  // - mirrors grammar.ts's tpegModuleFile, whose trailing `transforms`
  // blocks merge into the returned grammar's `transforms` array after the
  // grammar block's own embedded ones (transformDefinitionNode already
  // starts with its own wsAndComments, so the separator here is redundant
  // but harmless - it mirrors the hand-written parser's
  // optionalWhitespaceOrComment separator exactly).
  tpegFileNode = imports:(leadingContent importStatementNode)* grammar:modularGrammarBlockNode trailing:(wsAndComments transformDefinitionNode)* {
    const ts = trailing.map((t: any) => t[1]);
    return {
      imports: imports.map((i: any) => i[1]),
      grammar: ts.length === 0
        ? grammar
        : { ...grammar, transforms: [...(grammar.transforms ?? []), ...ts] },
    };
  }
}
