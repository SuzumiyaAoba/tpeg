{
  "name": "@suzumiyaaoba/tpeg-type-inference",
  "version": "0.1.0",
  "description": "Type inference system for TPEG grammar definitions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "README.ja.md", "package.json"],
  "scripts": {
    "test": "bun test",
    "build": "tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suzumiyaaoba/tpeg-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "keywords": ["tpeg", "parser", "type-inference", "typescript", "grammar"],
  "author": "TPEG Team",
  "license": "MIT"
}
