{
  "name": "@suzumiyaaoba/tpeg-type-inference",
  "version": "0.1.0",
  "description": "Type inference system for TPEG grammar definitions",
  "keywords": [
    "grammar",
    "parser",
    "tpeg",
    "type-inference",
    "typescript"
  ],
  "license": "MIT",
  "author": "TPEG Team",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "cd ../.. && vp test packages/type-inference",
    "build": "cd ../.. && vp -C packages/type-inference pack",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@suzumiyaaoba/tpeg-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
